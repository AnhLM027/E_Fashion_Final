# --- App Settings ---
PROJECT_NAME="MBA RAG Hybrid System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Database Connections ---
# PostgreSQL (Vector & KV for Graph)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lightrag
# Qdrant (Dense Vector Store)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Neo4j (Graph Storage - Optional if using LightRAG default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# MongoDB (Chat History & Debate Results)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=mba_mini

# --- LLM Providers ---
# Choose: "openai" | "gemini" | "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxx
GOOGLE_AI_API_KEY=xxxx

# OpenAI config
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Gemini config
LLM_MODEL_FAST=gemini-1.5-flash
LLM_THINKING_LEVEL=medium

# Ollama config
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Knowledge Graph (LightRAG) ---
NEXUSRAG_ENABLE_KG=true
NEXUSRAG_KG_LANGUAGE=Vietnamese
NEXUSRAG_KG_ENTITY_TYPES=["Concept", "Person", "Organization", "Event", "Document", "Course"]
NEXUSRAG_KG_CHUNK_TOKEN_SIZE=1200
NEXUSRAG_KG_QUERY_TIMEOUT=30.0

# --- RAG Pipeline Settings ---
NEXUSRAG_CHUNK_MAX_TOKENS=512
NEXUSRAG_EMBEDDING_MODEL=BAAI/bge-m3
NEXUSRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NEXUSRAG_MIN_RELEVANCE_SCORE=0.5
NEXUSRAG_VECTOR_PREFETCH=20

# --- Security ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5001", "http://localhost:5173"]
